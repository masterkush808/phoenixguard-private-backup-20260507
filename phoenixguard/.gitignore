# PhoenixGuard source-control boundary.
# Keep code, tests, docs, scripts, assets, and lightweight fixtures in git.
# Keep local environments, live sessions, model caches, logs, and secrets out.

# Python/test artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments
.venv/
.venv-live/
.venv-dev/
.venv-training/
.venv-business/
.venv-docs/
venv/
env/
ENV/
node_modules/

# Nested frontend build/test caches
.next/
out/
playwright-report/
test-results/
*.tsbuildinfo

# Runtime/capture/debug output
.codex_runtime/
/.runtime/
/runtime_launcher_io/
.codex_logs/
/runtime/
.backups/
_backups/
.gradio/
.tmp_obs/
.tmp_obs2/
.tmp_tracker/
.tmp_tracker2/
logs/
reports/
_archive/runtime_backup/
*.log
*.log.*
