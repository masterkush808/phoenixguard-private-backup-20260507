PHOENIXGUARD_PYTHON_PROFILE=live
PHOENIXGUARD_PYTHON_ENV_NAME=.venv-live
PHOENIXGUARD_PYTHON_EXE=/opt/phoenixguard/phoenixguard/.venv-live/bin/python
PHOENIXGUARD_MOBILE_API_HOST=127.0.0.1
PHOENIXGUARD_MOBILE_API_PORT=8793
PHOENIXGUARD_TRACKER_SESSION_ID=cloud-live
PHOENIXGUARD_RUNTIME_DIR=/opt/phoenixguard/phoenixguard/runtime/live
PHOENIXGUARD_DATA_DIR=/opt/phoenixguard/phoenixguard/runtime/live/data_live
PHOENIXGUARD_LOGS_DIR=/opt/phoenixguard/phoenixguard/runtime/live/logs_live
PHOENIXGUARD_FRAME_INGEST_TOKEN=replace-with-long-random-secret
PHOENIXGUARD_FRAME_INGEST_MAX_SOURCE_AGE_SEC=180
PHOENIXGUARD_ENABLE_OTEL=0
