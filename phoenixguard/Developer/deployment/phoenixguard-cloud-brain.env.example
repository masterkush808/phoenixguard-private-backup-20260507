PHOENIXGUARD_PYTHON_PROFILE=live
PHOENIXGUARD_PYTHON_ENV_NAME=.venv-live
PHOENIXGUARD_PYTHON_EXE=/opt/phoenixguard/phoenixguard/.venv-live/bin/python
PHOENIXGUARD_MOBILE_API_HOST=127.0.0.1
PHOENIXGUARD_MOBILE_API_PORT=8793
PHOENIXGUARD_TRACKER_SESSION_ID=cloud-live
PHOENIXGUARD_RUNTIME_DIR=/opt/phoenixguard/phoenixguard/runtime/live
PHOENIXGUARD_DATA_DIR=/opt/phoenixguard/phoenixguard/runtime/live/data_live
PHOENIXGUARD_LOGS_DIR=/opt/phoenixguard/phoenixguard/runtime/live/logs_live
PHOENIXGUARD_FRAME_INGEST_TOKEN_REGISTRY=/etc/phoenixguard/frame_ingest_token_registry.json
PHOENIXGUARD_FEED_TOKEN_ADMIN=replace-with-long-random-secret
PHOENIXGUARD_FEED_SIGNING_SECRET_ADMIN=replace-with-separate-long-random-signing-secret
PHOENIXGUARD_FRAME_INGEST_REQUIRE_SIGNATURE=1
PHOENIXGUARD_FRAME_INGEST_SIGNATURE_MAX_SKEW_SEC=300
PHOENIXGUARD_FRAME_INGEST_SIGNATURE_NONCE_TTL_SEC=600
PHOENIXGUARD_FRAME_INGEST_MAX_SOURCE_AGE_SEC=180
PHOENIXGUARD_FRAME_INGEST_REQUIRE_CAPTURE_EPOCH=1
PHOENIXGUARD_FRAME_INGEST_REQUIRE_FRAME_ID=1
PHOENIXGUARD_FRAME_INGEST_MIN_INTERVAL_SEC=10
PHOENIXGUARD_FRAME_INGEST_MAX_ACTIVE_FEEDS_TOTAL=3
PHOENIXGUARD_FRAME_INGEST_MAX_ACTIVE_FEEDS_PER_TOKEN=1
PHOENIXGUARD_FRAME_INGEST_ALLOWED_ORIGINS=https://phoenixguard.example.com
PHOENIXGUARD_ALLOWED_ORIGINS=https://phoenixguard.example.com
PHOENIXGUARD_TRUSTED_HOSTS=phoenixguard.example.com,127.0.0.1,localhost
PHOENIXGUARD_ENABLE_OTEL=0
PHOENIXGUARD_SECURITY_AUDIT_LOG_ENABLED=1
PHOENIXGUARD_SECURITY_AUDIT_LOG=/opt/phoenixguard/phoenixguard/runtime/live/logs_live/security_audit.jsonl

# Business onboarding, email verification, and payment providers.
PHOENIXGUARD_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USE_SSL=0
SMTP_FROM_NAME=808Fx Standard Hybrid
SMTP_FROM_EMAIL=replace-with-sender-email
SMTP_USERNAME=replace-with-sender-email
SMTP_PASSWORD=

PHOENIXGUARD_PAYMENT_PROVIDER=paypal
PAYPAL_MODE=sandbox
PAYPAL_MERCHANT_EMAIL=replace-with-paypal-merchant-email
PAYPAL_CURRENCY=USD
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL=https://phoenixguard.example.com/checkout/success
PAYPAL_CANCEL_URL=https://phoenixguard.example.com/checkout/cancel
