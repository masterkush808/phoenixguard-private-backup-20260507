[Unit]
Description=PhoenixGuard Cloud Brain API and frame-ingest tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phoenixguard
Group=phoenixguard
WorkingDirectory=/opt/phoenixguard/phoenixguard
EnvironmentFile=/etc/phoenixguard/cloud-brain.env
ExecStart=/opt/phoenixguard/phoenixguard/.venv-live/bin/python Backend/launch/start_phoenixguard_mobile_api.py
Restart=always
RestartSec=8
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
